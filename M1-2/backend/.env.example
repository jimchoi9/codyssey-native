# Comma-separated exact frontend origins. Empty means no cross-origin access.
ALLOWED_ORIGINS=http://localhost:5500
FIREBASE_PROJECT_ID=
# Absolute path to a server-only service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
OPENAI_API_KEY=
# Choose an accessible model explicitly before enabling the future GPT adapter.
OPENAI_MODEL=
# Planned adapter policy: output 512 tokens, timeout 45 seconds, retries 0.
